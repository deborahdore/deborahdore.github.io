<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <h6 class="title font-weight-bold">{{ content.name }}</h6>
      <p class="mb-0">{{ content.summary }}</p>
      {% if content.links %}
        <div class="container-links">
          {% for item in content.links %}
            <div class="container-link-button">
              <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" class="btncv z-depth-0">{{ item.name }}</a>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </li>
  {% endfor %}
</ul>
